# ============================================================
# Claude Agent VPS — Environment Variables
# Copy to ~/.claude/memory-system/.env and fill in values
# chmod 600 ~/.claude/memory-system/.env
# ============================================================

# --- LLM & Embeddings (OpenAI) ---
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=sk-proj-...

EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
EMBEDDING_API_KEY=sk-proj-...   # тот же ключ, что LLM_API_KEY

# --- Graph DB (Neo4j) ---
GRAPH_DATABASE_PROVIDER=neo4j
GRAPH_DATABASE_URL=bolt://localhost:7687
GRAPH_DATABASE_USERNAME=neo4j
GRAPH_DATABASE_PASSWORD=CHANGE_ME_RANDOM_32CHARS

# --- Vector + Relational DB (Postgres + pgvector) ---
VECTOR_DB_PROVIDER=pgvector
VECTOR_DB_HOST=localhost
VECTOR_DB_PORT=5432
VECTOR_DB_USERNAME=cognee
VECTOR_DB_PASSWORD=CHANGE_ME_RANDOM_32CHARS
VECTOR_DB_NAME=cognee   # именно _NAME: cognee 1.1.0 не читает _DATABASE

DB_PROVIDER=postgres
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=cognee
DB_PASSWORD=CHANGE_ME_RANDOM_32CHARS
DB_NAME=cognee          # именно _NAME

# --- GitHub MCP ---
GITHUB_PAT=ghp_...
GITHUB_PERSONAL_ACCESS_TOKEN=ghp_...

# --- SearXNG ---
SEARXNG_SECRET=CHANGE_ME_RANDOM_64CHARS

# --- Misc ---
ENABLE_BACKEND_ACCESS_CONTROL=false
