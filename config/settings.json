{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "DISABLE_AUTOUPDATER": "0",
    "CLAUDE_CODE_AUTO_COMPACT_WINDOW": "400000",
    "GIT_ASKPASS": "/bin/true"
  },
  "permissions": {
    "allow": [
      "Bash(*)",
      "Edit(*)",
      "Write(*)",
      "Read(*)",
      "WebFetch(*)",
      "mcp__*"
    ],
    "defaultMode": "bypassPermissions"
  },
  "sandbox": {
    "enabled": false
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "CLAUDE_DIR/hooks/session-start.sh",
            "timeout": 20
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "CLAUDE_DIR/hooks/summarize-to-handoff.sh",
            "async": true
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "CLAUDE_DIR/hooks/summarize-to-handoff.sh",
            "async": true
          }
        ]
      }
    ]
  }
}
